                2,
                3,
                4,
                5,
                6
            ],
            "x-enum-varnames": [
                "RulePerformanceAction_All",
                "RulePerformanceAction_DelayInMilliseconds",
                "RulePerformanceAction_DelayInTicks",
                "RulePerformanceAction_Reject",
                "RulePerformanceAction_ConfirmByPrice",
                "RulePerformanceAction_ConfirmByMarket",
                "RulePerformanceAction_CancelOrder"
            ]
        },
        "models.RuleRequest": {
            "type": "integer",
            "enum": [
                0,
                1,
                2,
                3,
                4,
                5,
                6,
                7
            ],
            "x-enum-varnames": [
                "RuleRequest_All",
                "RuleRequest_Price",
                "RuleRequest_MarketExecution",
                "RuleRequest_InstantExecution",
                "RuleRequest_PendingOrders",
                "RuleRequest_SLTPModification",
                "RuleRequest_RequestExecution",
                "RuleRequest_SLActivation"
            ]
        }
    }
}